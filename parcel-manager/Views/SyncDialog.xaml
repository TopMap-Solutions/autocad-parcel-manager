<Window
    x:Class="ParcelManager.Views.SyncDialog"
    Icon="/Assets/topmap-logo.png"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Synchronizing | Land Parcel Manager"
    Width="360"
    Height="240"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Background="White">

    <Grid Margin="30">

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Image
                Source="/Assets/topmap-logo.png"
                Width="42"
                Height="42"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                Margin="0,0,0,12" />

            <TextBlock
                Text="Syncing"
                FontSize="20"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Foreground="#222222" />

            <TextBlock
                Text="Please wait while the project is synchronized."
                FontSize="12"
                Foreground="#777777"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0,8,0,18" />

            <ProgressBar
                Width="220"
                Height="4"
                IsIndeterminate="True" />

        </StackPanel>

    </Grid>

</Window>