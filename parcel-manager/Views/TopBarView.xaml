<UserControl
    x:Class="ParcelManager.Views.TopBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

	<Border
        Background="White"
        BorderBrush="#E2E4E8"
        BorderThickness="0,0,0,1">

		<Grid Margin="16,0,26,0">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<!-- APP NAME -->

			<StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Height="39"
                Margin="10,0,20,0">

				<TextBlock
                    Text="Land Parcel Manager"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="#222222" />

				<TextBlock
                    Text="Powered by TopMap Solutions"
                    FontSize="10"
                    Foreground="#777777" />

			</StackPanel>

			<!-- USER -->

			<StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Margin="0,0,20,0">

				<TextBlock
                    x:Name="UsernameText"
                    FontWeight="SemiBold"
                    FontSize="13"
                    Foreground="#222222" />

				<TextBlock
                    Text="Signed in"
                    FontSize="10"
                    Foreground="#777777" />

			</StackPanel>

			<!-- LOGOUT -->

			<Button
                Grid.Column="3"
                Content="Logout"
                Width="70"
                Height="30"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="#D5D7DB"
                BorderThickness="1"
                Click="Logout_Click"
                Cursor="Hand" />

		</Grid>

	</Border>

</UserControl>