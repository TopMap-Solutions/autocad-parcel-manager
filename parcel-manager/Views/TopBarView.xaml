<UserControl
    x:Class="ParcelManager.Views.TopBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Background="White"
        BorderBrush="#E2E4E8"
        BorderThickness="0,0,0,1">

        <Grid Margin="26,3,26,6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>


            <Image
                Grid.Column="0"
                Source="/Assets/topmap-logo.png"
                Width="38"
                Height="38"
                Stretch="Uniform"
                VerticalAlignment="Center"
                Margin="0,0,12,0" />


            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Margin="0,0,20,0">

                <TextBlock
                    Text="Land Parcel Manager"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="#222222" />

                <TextBlock
                    Text="Powered by TopMap Solutions"
                    FontSize="10"
                    Foreground="#777777"
                    Margin="0,1,0,0" />

            </StackPanel>


            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Margin="0,0,20,0">

                <TextBlock
                    x:Name="UsernameText"
                    FontWeight="SemiBold"
                    FontSize="13"
                    Foreground="#222222" />

                <TextBlock
                    Text="Signed in"
                    FontSize="10"
                    Foreground="#777777"
                    Margin="0,1,0,0" />

            </StackPanel>


            <Button
                Grid.Column="3"
                Content="Logout"
                Width="70"
                Height="30"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="#D5D7DB"
                BorderThickness="1"
                Click="Logout_Click"
                Cursor="Hand" />

        </Grid>

    </Border>

</UserControl>