<Window
    x:Class="ParcelManager.Views.MainWindow"
    Icon="/Assets/topmap-logo.png"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ParcelManager.Views"
    mc:Ignorable="d"
    Title="Land Parcel Manager"
    Height="600"
    Width="900"
    MinHeight="500"
    MinWidth="750"
    WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F6F8">

        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:TopBarView
            x:Name="TopBar"
            Grid.Row="0" />

        <ContentControl
            x:Name="MainContent"
            Grid.Row="1"
            Margin="25" />

    </Grid>

</Window>