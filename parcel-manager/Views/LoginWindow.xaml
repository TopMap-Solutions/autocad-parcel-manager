<Window
    x:Class="ParcelManager.Views.LoginWindow"
    Icon="/Assets/topmap-logo.png"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Login"
    Width="420"
    Height="500"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F6F8">

        <Border
            Width="340"
            Padding="30"
            Background="White"
            BorderBrush="#E2E4E8"
            BorderThickness="1"
            CornerRadius="6"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel>

                <!-- LOGO / BRAND -->

                <StackPanel
                    HorizontalAlignment="Center"
                    Margin="0,0,0,30">

                    <Image
                        Source="/Assets/topmap-logo.png"
                        Width="55"
                        Height="55"
                        Margin="0,0,0,12" />

                    <TextBlock
                        Text="Land Parcel Manager"
                        FontSize="20"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        Foreground="#222222" />

                    <TextBlock
                        Text="Powered by TopMap Solutions"
                        FontSize="11"
                        Foreground="#777777"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0" />

                </StackPanel>


                <!-- USERNAME -->

                <TextBlock
                    Text="Username"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#444444"
                    Margin="0,0,0,6" />

                <TextBox
                    x:Name="UsernameTextBox"
                    Height="36"
                    Padding="10,0"
                    VerticalContentAlignment="Center"
                    Margin="0,0,0,16" />


                <!-- PASSWORD -->

                <TextBlock
                    Text="Password"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#444444"
                    Margin="0,0,0,6" />

                <Grid
                    Height="36"
                    Margin="0,0,0,10">

                    <!-- HIDDEN PASSWORD -->

                    <PasswordBox
                        x:Name="PasswordBox"
                        Height="36"
                        Padding="10,0,40,0"
                        VerticalContentAlignment="Center" />

                    <!-- VISIBLE PASSWORD -->

                    <TextBox
                        x:Name="VisiblePasswordBox"
                        Height="36"
                        Padding="10,0,40,0"
                        VerticalContentAlignment="Center"
                        Visibility="Collapsed" />

                    <!-- SHOW / HIDE BUTTON -->

                    <Button
                        x:Name="ShowPasswordButton"
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,2,0"
                        Content="◉"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="#777777"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ShowPassword_Click" />

                </Grid>


                <!-- ERROR -->

                <TextBlock
                    x:Name="ErrorText"
                    Text=""
                    Foreground="#C62828"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Margin="0,0,0,12" />


                <!-- LOGIN -->

                <Button
                    x:Name="LoginButton"
                    Content="Login"
                    Height="38"
                    Background="#222222"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Login_Click" />

            </StackPanel>

        </Border>

    </Grid>

</Window>