<Window
    x:Class="ParcelManager.Views.AppConfigWindow"
    Icon="/Assets/topmap-logo.png"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Configuration | Land Parcel Manager"
    Width="500"
    Height="390"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize">

	<Grid Margin="24">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>


		<!-- ====================================================== -->
		<!-- TITLE -->
		<!-- ====================================================== -->

		<StackPanel
            Orientation="Horizontal"
            VerticalAlignment="Center">

			<Image
                Source="/Assets/topmap-logo.png"
                Width="42"
                Height="51"
                Stretch="Uniform"
                VerticalAlignment="Center"
                Margin="0,0,12,0" />

			<StackPanel
                VerticalAlignment="Center">

				<TextBlock
                    Text="Land Parcel Manager"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#222222" />

				<TextBlock
                    Text="Application Configuration"
                    FontSize="11"
                    Foreground="#777777"
                    Margin="0,2,0,0" />

			</StackPanel>

		</StackPanel>


		<!-- ====================================================== -->
		<!-- SERVER URL -->
		<!-- ====================================================== -->

		<StackPanel
            Grid.Row="1"
            Margin="0,24,0,0">

			<TextBlock
                Text="Server URL"
                FontWeight="SemiBold"
                Foreground="#222222" />

			<TextBox
                x:Name="ServerUrlTextBox"
                Margin="0,6,0,0"
                Height="32"
                Padding="8,0"
                VerticalContentAlignment="Center" />

			<TextBlock
                Text="Example: http://127.0.0.1:8000/"
                FontSize="10"
                Foreground="#777777"
                Margin="0,5,0,0" />

		</StackPanel>


		<!-- ====================================================== -->
		<!-- AUTOCAD CORE CONSOLE -->
		<!-- ====================================================== -->

		<StackPanel
            Grid.Row="2"
            Margin="0,20,0,0">

			<TextBlock
                Text="AutoCAD Core Path"
                FontWeight="SemiBold"
                Foreground="#222222" />

			<TextBox
                x:Name="CoreConsolePathTextBox"
                Margin="0,6,0,0"
                Height="32"
                Padding="8,0"
                VerticalContentAlignment="Center" />

			<TextBlock
                Text="Example: C:\Program Files\Autodesk\AutoCAD 2027\accoreconsole.exe"
                FontSize="10"
                Foreground="#777777"
                Margin="0,5,0,0"
                TextWrapping="Wrap" />

		</StackPanel>


		<!-- ====================================================== -->
		<!-- BUTTONS -->
		<!-- ====================================================== -->

		<Grid
            Grid.Row="4"
            Margin="0,20,0,4">

			<!-- RESET -->

			<Button
                Content="Reset to Default"
                Width="110"
                Height="32"
                HorizontalAlignment="Left"
                Click="Reset_Click" />


			<!-- CANCEL / SAVE -->

			<StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right">

				<Button
                    Content="Cancel"
                    Width="80"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />

				<Button
                    Content="Save"
                    Width="80"
                    Height="32"
                    Click="Save_Click" />

			</StackPanel>

		</Grid>

	</Grid>

</Window>