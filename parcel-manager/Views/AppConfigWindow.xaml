<Window
    x:Class="ParcelManager.Views.AppConfigWindow"
    Icon="/Assets/topmap-logo.png"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Configuration | Land Parcel Manager"
    Width="500"
    Height="360"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize">

	<Grid Margin="24">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>


		<!-- TITLE -->

		<TextBlock
            Text="Land Parcel Manager Configuration"
            FontSize="20"
            FontWeight="SemiBold" />


		<!-- SERVER URL -->

		<StackPanel
            Grid.Row="1"
            Margin="0,24,0,0">

			<TextBlock
                Text="Server URL"
                FontWeight="SemiBold" />

			<TextBox
                x:Name="ServerUrlTextBox"
                Margin="0,6,0,0"
                Height="32"
                Padding="8,0"
                VerticalContentAlignment="Center" />

			<TextBlock
                Text="Example: http://127.0.0.1:8000/"
                FontSize="10"
                Foreground="#777777"
                Margin="0,5,0,0" />

		</StackPanel>


		<!-- AUTOCAD CORE CONSOLE -->

		<StackPanel
            Grid.Row="2"
            Margin="0,20,0,0">

			<TextBlock
                Text="AutoCAD Core Path"
                FontWeight="SemiBold" />

			<TextBox
                x:Name="CoreConsolePathTextBox"
                Margin="0,6,0,0"
                Height="32"
                Padding="8,0"
                VerticalContentAlignment="Center" />

			<TextBlock
                Text="Path to accoreconsole.exe"
                FontSize="10"
                Foreground="#777777"
                Margin="0,5,0,0" />

		</StackPanel>


		<!-- BUTTONS -->

		<Grid
            Grid.Row="4"
            Margin="0,20,0,0">

			<!-- RESET -->

			<Button
                Content="Reset to Default"
                Width="110"
                Height="32"
                HorizontalAlignment="Left"
                Click="Reset_Click" />


			<!-- CANCEL / SAVE -->

			<StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right">

				<Button
                    Content="Cancel"
                    Width="80"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />

				<Button
                    Content="Save"
                    Width="80"
                    Height="32"
                    Click="Save_Click" />

			</StackPanel>

		</Grid>

	</Grid>

</Window>